@{ ViewData["Title"] = "Audit Log"; var logs = (List<DAL.Models.Entities.AuditLog>)ViewBag.Logs; }

<div class="py-5">
    <div class="container-fluid px-4">
        <h1 class="h3 fw-bold mb-4"><i class="fas fa-history text-primary me-2"></i>Audit Log</h1>

        <form method="get" class="d-flex gap-2 mb-3" style="max-width:640px;">
            <input type="text" name="action" value="@ViewBag.Action" class="form-control" placeholder="Filter by action (e.g. UpdateSettings)" />
            <select name="userId" class="form-select" style="max-width:220px;">
                <option value="">All users</option>
                @foreach (var u in (System.Collections.Generic.IEnumerable<dynamic>)ViewBag.Users)
                {
                    <option value="@u.UserId" selected="@(ViewBag.UserId == u.UserId)">@u.FullName</option>
                }
            </select>
            <button class="btn btn-outline-primary">Filter</button>
        </form>

        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead><tr><th>Time</th><th>User</th><th>Action</th><th>Entity</th><th>Details</th><th>IP</th></tr></thead>
                    <tbody>
                        @foreach (var l in logs)
                        {
                            <tr>
                                <td class="text-nowrap">@l.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@l.User?.FullName</td>
                                <td><span class="badge text-bg-light border">@l.Action</span></td>
                                <td>@l.EntityType @(l.EntityId != null ? $"#{l.EntityId}" : "")</td>
                                <td class="small text-muted">@l.Details</td>
                                <td class="small text-muted">@l.IpAddress</td>
                            </tr>
                        }
                        @if (logs.Count == 0)
                        {
                            <tr><td colspan="6" class="text-muted text-center py-4">No audit entries.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
