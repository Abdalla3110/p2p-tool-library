@{ ViewData["Title"] = "Manage Tools"; var tools = (List<DAL.Models.Entities.Tool>)ViewBag.Tools; }

<div class="py-5">
    <div class="container-fluid px-4">
        <h1 class="h3 fw-bold mb-4"><i class="fas fa-toolbox text-primary me-2"></i>Manage Tools</h1>

        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>#</th><th>Name</th><th>Category</th><th>Owner</th><th>Status</th><th>Price/day</th><th>Rentals</th><th>Rating</th><th>Active</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var t in tools)
                        {
                            <tr>
                                <td>@t.ToolId</td>
                                <td><strong>@t.Name</strong></td>
                                <td>@t.Category?.Name</td>
                                <td>@t.OwnerUser?.FullName</td>
                                <td><span class="badge text-bg-secondary">@t.Status</span></td>
                                <td>@t.PricePerDay.ToString("0") EGP</td>
                                <td>@t.TotalRentals</td>
                                <td>@t.RatingAverage.ToString("0.0") (@t.ReviewCount)</td>
                                <td>@(t.IsActive ? "Yes" : "No")</td>
                                <td>
                                    @if (t.IsActive)
                                    {
                                        <form asp-action="SuspendTool" asp-route-id="@t.ToolId" method="post" class="d-inline" onsubmit="return confirm('Suspend this tool?');">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-danger">Suspend</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="ReinstateTool" asp-route-id="@t.ToolId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-success">Reinstate</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
