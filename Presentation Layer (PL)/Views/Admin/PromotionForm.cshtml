@model DAL.Models.ViewModels.PromotionFormViewModel
@{ ViewData["Title"] = Model.PromotionId == 0 ? "New Promotion" : "Edit Promotion"; }

<div class="py-5">
    <div class="container" style="max-width: 760px;">
        <h1 class="h3 fw-bold mb-4"><i class="fas fa-tag text-primary me-2"></i>@(Model.PromotionId == 0 ? "New Promotion" : "Edit Promotion")</h1>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <form method="post" asp-action="PromotionSave">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PromotionId" />
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="Code" class="form-label">Code</label>
                            <input asp-for="Code" class="form-control text-uppercase" />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Description" class="form-label">Description</label>
                            <input asp-for="Description" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DiscountType" class="form-label">Type</label>
                            <select asp-for="DiscountType" class="form-select">
                                <option value="Percentage">Percentage</option>
                                <option value="FixedAmount">Fixed amount</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DiscountPercentage" class="form-label">Percentage %</label>
                            <input asp-for="DiscountPercentage" type="number" step="0.1" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DiscountAmount" class="form-label">Fixed EGP</label>
                            <input asp-for="DiscountAmount" type="number" step="0.01" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label">Category (optional)</label>
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"><option value="">All categories</option></select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MaxUses" class="form-label">Max uses (optional)</label>
                            <input asp-for="MaxUses" type="number" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="StartDate" class="form-label">Start date</label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EndDate" class="form-label">End date (optional)</label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label">Status</label>
                            <select asp-for="Status" class="form-select">
                                <option>Active</option><option>Scheduled</option><option>Disabled</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save</button>
                <a asp-action="Promotions" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
