@{ ViewData["Title"] = "Admin Dashboard"; }

<div class="py-5">
    <div class="container-fluid px-4">
        <h1 class="h3 fw-bold mb-1"><i class="fas fa-user-shield text-primary me-2"></i>Admin Dashboard</h1>
        <p class="text-muted mb-4">Platform-wide oversight — users, revenue, disputes, and system health.</p>

        <div class="row g-3 mb-4">
            <div class="col-xl-2 col-md-4 col-6"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Users</div><div class="display-6 fw-bold text-primary">@ViewBag.TotalUsers</div></div></div></div>
            <div class="col-xl-2 col-md-4 col-6"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Active users</div><div class="display-6 fw-bold text-success">@ViewBag.ActiveUsers</div></div></div></div>
            <div class="col-xl-2 col-md-4 col-6"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Tools</div><div class="display-6 fw-bold">@ViewBag.TotalTools</div><div class="text-muted small">@ViewBag.AvailableTools available</div></div></div></div>
            <div class="col-xl-2 col-md-4 col-6"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Bookings</div><div class="display-6 fw-bold">@ViewBag.TotalBookings</div></div></div></div>
            <div class="col-xl-2 col-md-4 col-6"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">GMV</div><div class="display-6 fw-bold text-info">@(((decimal)ViewBag.Gmv).ToString("0"))</div></div></div></div>
            <div class="col-xl-2 col-md-4 col-6"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Platform revenue</div><div class="display-6 fw-bold text-success">@(((decimal)ViewBag.PlatformRevenue).ToString("0"))</div></div></div></div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4"><div class="card shadow-sm border-danger"><div class="card-body"><div class="d-flex justify-content-between"><div><div class="text-muted small">Open disputes</div><div class="display-6 fw-bold text-danger">@ViewBag.OpenDisputes</div></div><a asp-controller="Library" asp-action="Disputes" class="btn btn-sm btn-outline-danger align-self-center">Review</a></div></div></div></div>
            <div class="col-md-4"><div class="card shadow-sm border-warning"><div class="card-body"><div class="d-flex justify-content-between"><div><div class="text-muted small">Pending tool approvals</div><div class="display-6 fw-bold text-warning">@ViewBag.PendingTools</div></div><a asp-controller="Library" asp-action="Tools" class="btn btn-sm btn-outline-warning align-self-center">Review</a></div></div></div></div>
            <div class="col-md-4"><div class="card shadow-sm border-info"><div class="card-body"><div class="d-flex justify-content-between"><div><div class="text-muted small">Pending KYC</div><div class="display-6 fw-bold text-info">@ViewBag.PendingKyc</div></div><a asp-controller="Library" asp-action="Users" class="btn btn-sm btn-outline-info align-self-center">Review</a></div></div></div></div>
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white d-flex justify-content-between">
                        <h2 class="h6 mb-0">Monthly platform revenue</h2>
                        <a asp-action="Revenue" class="btn btn-sm btn-outline-primary">Revenue reports</a>
                    </div>
                    <div class="card-body">
                        @foreach (var m in (List<(string Label, decimal Revenue, int Bookings)>)ViewBag.Monthly)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted">@m.Label</span>
                                <div class="d-flex align-items-center gap-3">
                                    <span class="small text-muted">@m.Bookings bookings</span>
                                    <strong>@m.Revenue.ToString("0") EGP</strong>
                                </div>
                            </div>
                            <div class="progress" style="height:6px;"><div class="progress-bar bg-success" style="width:@(m.Revenue > 0 ? Math.Min(100, (double)(m.Revenue / (((List<(string Label, decimal Revenue, int Bookings)>)ViewBag.Monthly).Max(x => x.Revenue)) * 100)) : 0)%"></div></div>
                        }
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header bg-white"><h2 class="h6 mb-0">Recent activity</h2></div>
                    <ul class="list-group list-group-flush">
                        @foreach (var a in (List<DAL.Models.Entities.AuditLog>)ViewBag.RecentActivity)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <div><strong>@a.Action</strong> <span class="text-muted small">@a.EntityType #@a.EntityId</span><div class="text-muted small">by @a.User?.FullName</div></div>
                                <span class="text-muted small">@a.CreatedAt.ToString("MM-dd HH:mm")</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card shadow-sm">
                    <div class="card-header bg-white"><h2 class="h6 mb-0">Latest transactions</h2></div>
                    <ul class="list-group list-group-flush">
                        @foreach (var t in (List<DAL.Models.Entities.Transaction>)ViewBag.RecentTransactions)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div><strong>@t.User?.FullName</strong><div class="text-muted small">@t.Type • @t.Description</div></div>
                                <span class="@(t.Amount >= 0 ? "text-success" : "text-danger") fw-semibold">@(t.Amount >= 0 ? "+" : "")@t.Amount.ToString("0")</span>
                            </li>
                        }
                    </ul>
                </div>
                <div class="card shadow-sm mt-4">
                    <div class="card-header bg-white"><h2 class="h6 mb-0">Quick actions</h2></div>
                    <div class="list-group list-group-flush">
                        <a asp-action="AddUser" class="list-group-item list-group-item-action"><i class="fas fa-user-plus text-success me-2"></i>Add user</a>
                        <a asp-action="Settings" class="list-group-item list-group-item-action"><i class="fas fa-cog text-primary me-2"></i>Platform settings</a>
                        <a asp-action="Revenue" class="list-group-item list-group-item-action"><i class="fas fa-chart-line text-info me-2"></i>Revenue reports</a>
                        <a asp-action="AuditLogs" class="list-group-item list-group-item-action"><i class="fas fa-history text-warning me-2"></i>Audit log</a>
                        <a asp-action="Activity" class="list-group-item list-group-item-action"><i class="fas fa-bolt text-danger me-2"></i>Live activity</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
