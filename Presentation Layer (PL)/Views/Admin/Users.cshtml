@{ ViewData["Title"] = "Manage Users"; var users = (List<DAL.Models.Entities.User>)ViewBag.Users; var roles = (List<DAL.Models.Entities.Role>)ViewBag.Roles; }

<div class="py-5">
    <div class="container-fluid px-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 fw-bold mb-0"><i class="fas fa-users text-primary me-2"></i>Users</h1>
            <a asp-action="AddUser" class="btn btn-primary"><i class="fas fa-user-plus"></i> Add user</a>
        </div>

        <form method="get" class="d-flex gap-2 mb-3" style="max-width:640px;">
            <select name="role" class="form-select" style="max-width:180px;">
                <option value="All" selected="@(ViewBag.Role == "All" || ViewBag.Role == null)">All roles</option>
                @foreach (var r in roles) { <option value="@r.Name" selected="@(ViewBag.Role == r.Name)">@r.Name</option> }
            </select>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search name or email" />
            <button class="btn btn-outline-primary">Filter</button>
        </form>

        @if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }

        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Zone</th><th>KYC</th><th>Trust</th><th>Wallet</th><th>Active</th><th>Joined</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var u in users)
                        {
                            <tr>
                                <td><strong>@u.FullName</strong></td>
                                <td>@u.Email</td>
                                <td>
                                    <form asp-action="ChangeRole" asp-route-id="@u.UserId" method="post" class="d-flex gap-1">
                                        @Html.AntiForgeryToken()
                                        <select name="roleId" class="form-select form-select-sm" style="width:auto;" @(u.UserId == int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value) ? "disabled" : "")>
                                            @foreach (var r in roles)
                                            {
                                                <option value="@r.RoleId" selected="@(u.RoleId == r.RoleId)">@r.Name</option>
                                            }
                                        </select>
                                        @if (u.UserId != int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value))
                                        {
                                            <button class="btn btn-sm btn-outline-primary">Set</button>
                                        }
                                    </form>
                                </td>
                                <td>@u.Zone?.Name</td>
                                <td><span class="badge @(u.KycStatus == KycStatusEnum.Verified ? "text-bg-success" : u.KycStatus == KycStatusEnum.Pending ? "text-bg-warning text-dark" : "text-bg-danger")">@u.KycStatus</span></td>
                                <td>@u.TrustScore</td>
                                <td>@u.WalletBalance.ToString("0") EGP</td>
                                <td>@(u.IsActive ? "Yes" : "No")</td>
                                <td>@u.JoinedAt.ToString("yyyy-MM-dd")</td>
                                <td>
                                    @if (u.UserId != int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value))
                                    {
                                        <form asp-action="ToggleUserActive" asp-route-id="@u.UserId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(u.IsActive ? "Deactivate" : "Activate")</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
