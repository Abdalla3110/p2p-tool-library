@{ ViewData["Title"] = "Live Activity"; }

<div class="py-5">
    <div class="container-fluid px-4">
        <h1 class="h3 fw-bold mb-4"><i class="fas fa-bolt text-primary me-2"></i>Live Activity</h1>
        <p class="text-muted">Latest transactions, audit events, and notifications across the platform.</p>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white"><h2 class="h6 mb-0">Transactions</h2></div>
                    <ul class="list-group list-group-flush" style="max-height:600px;overflow-y:auto;">
                        @foreach (var t in (List<DAL.Models.Entities.Transaction>)ViewBag.Transactions)
                        {
                            <li class="list-group-item py-2">
                                <div class="d-flex justify-content-between">
                                    <span>@t.User?.FullName</span>
                                    <span class="@(t.Amount >= 0 ? "text-success" : "text-danger") fw-semibold">@(t.Amount >= 0 ? "+" : "")@t.Amount.ToString("0")</span>
                                </div>
                                <div class="text-muted" style="font-size:.75rem;">@t.Type • @t.CreatedAt.ToString("MM-dd HH:mm")</div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white"><h2 class="h6 mb-0">Audit events</h2></div>
                    <ul class="list-group list-group-flush" style="max-height:600px;overflow-y:auto;">
                        @foreach (var a in (List<DAL.Models.Entities.AuditLog>)ViewBag.AuditLogs)
                        {
                            <li class="list-group-item py-2">
                                <strong>@a.Action</strong> <span class="text-muted small">@a.EntityType</span>
                                <div class="text-muted" style="font-size:.75rem;">@a.User?.FullName • @a.CreatedAt.ToString("MM-dd HH:mm")</div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white"><h2 class="h6 mb-0">Notifications</h2></div>
                    <ul class="list-group list-group-flush" style="max-height:600px;overflow-y:auto;">
                        @foreach (var n in (List<DAL.Models.Entities.Notification>)ViewBag.Notifications)
                        {
                            <li class="list-group-item py-2">
                                <strong>@n.Title</strong>
                                <div class="text-muted" style="font-size:.75rem;">@n.Type • @n.CreatedAt.ToString("MM-dd HH:mm")</div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
