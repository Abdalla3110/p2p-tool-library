@{ ViewData["Title"] = "Transactions Ledger"; var txns = (List<DAL.Models.Entities.Transaction>)ViewBag.Transactions; var types = (string[])ViewBag.Types; }

<div class="py-5">
    <div class="container-fluid px-4">
        <h1 class="h3 fw-bold mb-4"><i class="fas fa-list-alt text-primary me-2"></i>Transactions Ledger</h1>

        <form method="get" class="d-flex gap-2 mb-3" style="max-width:280px;">
            <select name="type" class="form-select">
                <option value="All" selected="@(ViewBag.Type == "All" || ViewBag.Type == null)">All types</option>
                @foreach (var t in types) { <option value="@t" selected="@(ViewBag.Type == t)">@t</option> }
            </select>
            <button class="btn btn-outline-primary">Filter</button>
        </form>

        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead><tr><th>#</th><th>Time</th><th>User</th><th>Type</th><th>Amount</th><th>Balance after</th><th>Status</th><th>Description</th><th>Ref</th></tr></thead>
                    <tbody>
                        @foreach (var t in txns)
                        {
                            <tr>
                                <td>@t.TransactionId</td>
                                <td class="text-nowrap">@t.CreatedAt.ToString("MM-dd HH:mm")</td>
                                <td>@t.User?.FullName</td>
                                <td><span class="badge text-bg-light border">@t.Type</span></td>
                                <td class="@(t.Amount >= 0 ? "text-success" : "text-danger") fw-semibold">@(t.Amount >= 0 ? "+" : "")@t.Amount.ToString("0.00")</td>
                                <td>@(t.BalanceAfter?.ToString("0.00") ?? "—")</td>
                                <td><span class="badge @(t.Status == TransactionStatusEnum.Completed || t.Status == TransactionStatusEnum.Released ? "text-bg-success" : t.Status == TransactionStatusEnum.Held ? "text-bg-warning text-dark" : "text-bg-secondary")">@t.Status</span></td>
                                <td class="small text-muted">@t.Description</td>
                                <td class="small text-muted">@t.Reference</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
