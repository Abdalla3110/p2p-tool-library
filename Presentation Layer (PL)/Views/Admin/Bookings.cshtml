@{ ViewData["Title"] = "All Bookings"; var bookings = (List<DAL.Models.Entities.Booking>)ViewBag.Bookings; var statuses = (string[])ViewBag.Statuses; }

<div class="py-5">
    <div class="container-fluid px-4">
        <h1 class="h3 fw-bold mb-4"><i class="fas fa-calendar-check text-primary me-2"></i>All Bookings</h1>

        <form method="get" class="d-flex gap-2 mb-3" style="max-width:320px;">
            <select name="status" class="form-select">
                <option value="All" selected="@(ViewBag.Status == "All" || ViewBag.Status == null)">All statuses</option>
                @foreach (var s in statuses) { <option value="@s" selected="@(ViewBag.Status == s)">@s.Replace("WaitingHandover", "Waiting handover")</option> }
            </select>
            <button class="btn btn-outline-primary">Filter</button>
        </form>

        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>#</th><th>Tool</th><th>Borrower</th><th>Lender</th><th>Dates</th><th>Total</th><th>Deposit</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var b in bookings)
                        {
                            <tr>
                                <td>@b.BookingId</td>
                                <td>@b.Tool?.Name</td>
                                <td>@b.BorrowerUser?.FullName</td>
                                <td>@b.LenderUser?.FullName</td>
                                <td class="small">@b.PickupDate.ToString("MM-dd") → @b.ReturnDate.ToString("MM-dd")</td>
                                <td>@b.FinalAmountDue.ToString("0") EGP</td>
                                <td>@b.DepositAmount.ToString("0") EGP (@b.DepositStatus)</td>
                                <td><span class="badge text-bg-secondary">@b.Status.ToString().Replace("WaitingHandover", "Waiting")</span></td>
                                <td><a asp-controller="Member" asp-action="Details" asp-route-id="@b.BookingId" class="btn btn-sm btn-outline-primary">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
