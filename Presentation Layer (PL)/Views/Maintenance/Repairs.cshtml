@{ ViewData["Title"] = "External Repairs"; var repairs = (List<DAL.Models.Entities.ExternalRepair>)ViewBag.Repairs; }

<div class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 fw-bold mb-0"><i class="fas fa-truck text-primary me-2"></i>External Repairs</h1>
            <a asp-action="RepairForm" class="btn btn-primary"><i class="fas fa-plus"></i> New repair</a>
        </div>

        <form method="get" class="d-flex gap-2 mb-3" style="max-width:320px;">
            <select name="status" class="form-select">
                <option value="All" selected="@(ViewBag.Status == "All" || ViewBag.Status == null)">All statuses</option>
                @foreach (var s in new[] { "Inspecting", "WaitingParts", "Completed", "Cancelled" }) { <option value="@s" selected="@(ViewBag.Status == s)">@s</option> }
            </select>
            <button class="btn btn-outline-primary">Filter</button>
        </form>

        @if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }

        @if (repairs.Count == 0)
        {
            <div class="alert alert-info">No external repairs.</div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead><tr><th>#</th><th>Tool</th><th>Repair center</th><th>Sent</th><th>Expected</th><th>Returned</th><th>Cost</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var r in repairs)
                            {
                                <tr>
                                    <td>@r.ExternalRepairId</td>
                                    <td>@r.Tool?.Name</td>
                                    <td>@r.RepairCenterName</td>
                                    <td>@r.SentAt?.ToString("yyyy-MM-dd")</td>
                                    <td>@r.ExpectedReturnAt?.ToString("yyyy-MM-dd")</td>
                                    <td>@r.ActualReturnAt?.ToString("yyyy-MM-dd")</td>
                                    <td>@(r.Cost?.ToString("0") ?? "—") EGP</td>
                                    <td><span class="badge @(r.Status == ExternalRepairStatusEnum.Completed ? "text-bg-success" : r.Status == ExternalRepairStatusEnum.Cancelled ? "text-bg-danger" : "text-bg-warning text-dark")">@r.Status</span></td>
                                    <td>
                                        @if (r.Status != ExternalRepairStatusEnum.Completed && r.Status != ExternalRepairStatusEnum.Cancelled)
                                        {
                                            <form asp-action="ReturnRepair" asp-route-id="@r.ExternalRepairId" method="post" class="d-flex gap-1">
                                                @Html.AntiForgeryToken()
                                                <input type="date" name="actualReturnAt" class="form-control form-control-sm" style="width:140px;" />
                                                <input type="number" name="cost" step="0.01" class="form-control form-control-sm" style="width:100px;" placeholder="Cost" />
                                                <button class="btn btn-sm btn-outline-success">Mark returned</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
