@{ ViewData["Title"] = "Disposals"; var disposals = (List<DAL.Models.Entities.Disposal>)ViewBag.Disposals; var isStaff = User.IsInRole("Librarian") || User.IsInRole("Admin"); }

<div class="py-5">
    <div class="container">
        <h1 class="h3 fw-bold mb-4"><i class="fas fa-trash text-primary me-2"></i>Disposals</h1>

        @if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white"><h2 class="h6 mb-0">Request disposal</h2></div>
            <div class="card-body">
                <form asp-action="CreateDisposal" method="post" class="row g-3 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-md-3">
                        <label class="form-label">Tool</label>
                        <select name="toolId" class="form-select" required>
                            <option value="">Choose…</option>
                            @foreach (var t in (System.Collections.Generic.IEnumerable<dynamic>)ViewBag.Tools)
                            {
                                <option value="@t.ToolId">@t.Name (@t.Status)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Reason</label>
                        <select name="reason" class="form-select" required>
                            <option>IrreparableDamage</option><option>SafetyRisk</option><option>EndOfLife</option><option>OwnerRequest</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Recycle center</label>
                        <input type="text" name="recycleCenter" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Description</label>
                        <input type="text" name="reasonDescription" class="form-control" />
                    </div>
                    <div class="col-md-1 form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="cancelFutureBookings" id="cfb" />
                        <label class="form-check-label small" for="cfb">Cancel bookings</label>
                    </div>
                    <div class="col-12"><button class="btn btn-outline-danger"><i class="fas fa-trash"></i> Submit request</button></div>
                </form>
            </div>
        </div>

        @if (disposals.Count == 0)
        {
            <div class="alert alert-info">No disposal requests.</div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>#</th><th>Tool</th><th>Reason</th><th>Center</th><th>Status</th><th>Disposed</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var d in disposals)
                            {
                                <tr>
                                    <td>@d.DisposalId</td>
                                    <td>@d.Tool?.Name</td>
                                    <td>@d.Reason</td>
                                    <td>@d.RecycleCenter</td>
                                    <td><span class="badge @(d.Status == DisposalStatusEnum.PendingPickup || d.Status == DisposalStatusEnum.Recycled ? "text-bg-success" : d.Status == DisposalStatusEnum.Cancelled ? "text-bg-danger" : "text-bg-warning text-dark")">@d.Status</span></td>
                                    <td>@d.DisposedAt?.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @if (d.Status == DisposalStatusEnum.Pending && isStaff)
                                        {
                                            <form asp-action="ApproveDisposal" asp-route-id="@d.DisposalId" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-success">Approve</button></form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
