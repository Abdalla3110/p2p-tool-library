@model List<DAL.Models.Entities.Booking>
@{ ViewData["Title"] = "My Bookings"; var uid = int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value); }

@functions {
    string Badge(string s) => s switch
    {
        "Completed" => "text-bg-success",
        "Cancelled" => "text-bg-danger",
        "Active" or "Confirmed" => "text-bg-primary",
        "Pending" => "text-bg-warning text-dark",
        "Disputed" => "text-bg-danger",
        _ => "text-bg-secondary",
    };
}

<div class="py-5">
    <div class="container">
        <h1 class="h3 fw-bold mb-1"><i class="fas fa-calendar-check text-primary me-2"></i>My Bookings</h1>
        <p class="text-muted mb-4">Rentals you're borrowing and tools you're lending.</p>

        @if (Model.Count == 0)
        {
            <div class="alert alert-info">No bookings yet. <a asp-controller="Home" asp-action="Tools">Browse tools</a> to get started.</div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead><tr><th>#</th><th>Tool</th><th>Role</th><th>Dates</th><th>Total</th><th>Deposit</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var b in Model)
                            {
                                var isBorrower = b.BorrowerUserId == uid;
                                <tr>
                                    <td>@b.BookingId</td>
                                    <td><strong>@b.Tool?.Name</strong><div class="text-muted small">@b.Tool?.Zone?.Name</div></td>
                                    <td><span class="badge text-bg-light border">@(isBorrower ? "Borrower" : "Lender")</span></td>
                                    <td>@b.PickupDate.ToString("yyyy-MM-dd") → @b.ReturnDate.ToString("yyyy-MM-dd")</td>
                                    <td>@b.TotalAmount.ToString("0") EGP</td>
                                    <td>@b.DepositAmount.ToString("0") EGP (@b.DepositStatus)</td>
                                    <td><span class="badge @Badge(b.Status.ToString())">@b.Status</span></td>
                                    <td><a asp-controller="Member" asp-action="Details" asp-route-id="@b.BookingId" class="btn btn-sm btn-outline-primary">Open</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
