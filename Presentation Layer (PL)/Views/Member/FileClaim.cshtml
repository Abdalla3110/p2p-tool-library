@model DAL.Models.ViewModels.InsuranceClaimFormViewModel
@{ var booking = (DAL.Models.Entities.Booking)ViewBag.Booking; ViewData["Title"] = "File Insurance Claim"; }

<div class="py-5">
    <div class="container" style="max-width: 720px;">
        <h1 class="h3 fw-bold mb-4"><i class="fas fa-file-invoice text-primary me-2"></i>File Insurance Claim</h1>

        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <strong>Booking #@booking.BookingId</strong> — @booking.Tool?.Name
            </div>
        </div>

        <form method="post" asp-action="Create">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="BookingId" />
            <input type="hidden" asp-for="ToolId" />
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ToolValue" class="form-label">Tool value (EGP)</label>
                            <input asp-for="ToolValue" type="number" step="0.01" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="IncidentDate" class="form-label">Incident date</label>
                            <input asp-for="IncidentDate" type="date" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label">What happened?</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe the incident…"></textarea>
                        </div>
                        <div class="col-12">
                            <label asp-for="DamagePhotoUrl" class="form-label">Photo URL (optional)</label>
                            <input asp-for="DamagePhotoUrl" class="form-control" placeholder="https://… or /uploads/…" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary"><i class="fas fa-paper-plane"></i> Submit Claim</button>
                <a asp-controller="Member" asp-action="Details" asp-route-id="@booking.BookingId" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
