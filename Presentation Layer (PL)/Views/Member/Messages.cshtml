@{ ViewData["Title"] = "Messages"; var convs = (System.Collections.Generic.IEnumerable<dynamic>)ViewBag.Conversations; }

<div class="py-5">
    <div class="container" style="max-width: 800px;">
        <h1 class="h3 fw-bold mb-4"><i class="fas fa-comments text-primary me-2"></i>Messages</h1>

        @if (!convs.Any())
        {
            <div class="alert alert-info">No conversations yet. Use "Ask the owner" on a tool page to start one.</div>
        }
        else
        {
            <div class="list-group">
                @foreach (var c in convs)
                {
                    <a asp-action="Conversation" asp-route-id="@c.ConversationId" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <strong>@c.Other.FullName</strong>
                                @if (c.Unread > 0) { <span class="badge text-bg-danger rounded-pill">@c.Unread</span> }
                            </div>
                            <div class="text-muted small">@(c.Subject ?? c.Tool?.Name)@(c.LastMessage != null ? " — " + c.LastMessage : "")</div>
                        </div>
                        <span class="text-muted small">@c.LastMessageAt?.ToString("MM-dd HH:mm")</span>
                    </a>
                }
            </div>
        }
    </div>
</div>
