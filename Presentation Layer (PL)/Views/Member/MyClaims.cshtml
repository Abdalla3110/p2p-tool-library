@model List<DAL.Models.Entities.InsuranceClaim>
@{ ViewData["Title"] = "My Claims"; }

<div class="py-5">
    <div class="container">
        <h1 class="h3 fw-bold mb-4"><i class="fas fa-file-invoice text-primary me-2"></i>My Insurance Claims</h1>

        @if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }

        @if (Model.Count == 0)
        {
            <div class="alert alert-info">No claims filed.</div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead><tr><th>#</th><th>Tool</th><th>Booking</th><th>Tool value</th><th>Status</th><th>Payout</th><th>Submitted</th></tr></thead>
                        <tbody>
                            @foreach (var c in Model)
                            {
                                <tr>
                                    <td>@c.ClaimId</td>
                                    <td>@c.Tool?.Name</td>
                                    <td>#@c.BookingId</td>
                                    <td>@(c.ToolValue?.ToString("0") ?? "—") EGP</td>
                                    <td><span class="badge @(c.Status == InsuranceClaimStatusEnum.Approved ? "text-bg-success" : c.Status == InsuranceClaimStatusEnum.Rejected ? "text-bg-danger" : c.Status == InsuranceClaimStatusEnum.InReview ? "text-bg-warning text-dark" : "text-bg-info")">@c.Status.ToString().Replace("InReview", "In review")</span></td>
                                    <td>@(c.PayoutAmount?.ToString("0") ?? "—") EGP</td>
                                    <td>@c.SubmittedAt.ToString("yyyy-MM-dd")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
