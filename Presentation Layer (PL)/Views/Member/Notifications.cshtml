@model List<DAL.Models.Entities.Notification>
@{ ViewData["Title"] = "Notifications"; }

<div class="py-5">
    <div class="container" style="max-width: 800px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 fw-bold mb-0"><i class="fas fa-bell text-primary me-2"></i>Notifications</h1>
            <form asp-action="MarkAllRead" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary btn-sm"><i class="fas fa-check-double"></i> Mark all read</button>
            </form>
        </div>

        @if (Model.Count == 0)
        {
            <div class="alert alert-info">No notifications.</div>
        }
        else
        {
            <div class="list-group">
                @foreach (var n in Model)
                {
                    <div class="list-group-item @(n.IsRead ? "" : "list-group-item-warning")">
                        <div class="d-flex justify-content-between">
                            <strong>@n.Title</strong>
                            <span class="badge text-bg-light border">@n.Type</span>
                        </div>
                        <div>@n.Message</div>
                        <div class="text-muted small">@n.CreatedAt.ToString("yyyy-MM-dd HH:mm") @(n.IsRead ? "" : "• unread")</div>
                    </div>
                }
            </div>
        }
    </div>
</div>
