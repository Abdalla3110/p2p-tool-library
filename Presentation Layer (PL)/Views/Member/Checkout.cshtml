@model DAL.Models.Entities.Booking
@{ ViewData["Title"] = "Checkout"; var promos = (List<DAL.Models.Entities.Promotion>)ViewBag.AvailablePromos; var wallet = (decimal)ViewBag.Wallet; }

<div class="py-5">
    <div class="container" style="max-width: 860px;">
        <h1 class="h3 fw-bold mb-4"><i class="fas fa-credit-card text-primary me-2"></i>Checkout</h1>

        @if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
        @if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white"><h2 class="h6 mb-0">Order summary</h2></div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2"><span>Tool</span><strong>@Model.Tool?.Name</strong></div>
                        <div class="d-flex justify-content-between mb-2"><span>Dates</span><span>@Model.PickupDate.ToString("yyyy-MM-dd") → @Model.ReturnDate.ToString("yyyy-MM-dd")</span></div>
                        <hr />
                        <div class="d-flex justify-content-between mb-1"><span>Rental (@Model.PickupDate.DayNumber - Model.ReturnDate.DayNumber days × daily/weekly rate)</span><span>@Model.RentalAmount.ToString("0.00") EGP</span></div>
                        <div class="d-flex justify-content-between mb-1"><span>Insurance</span><span>@Model.InsuranceAmount.ToString("0.00") EGP</span></div>
                        <div class="d-flex justify-content-between mb-1"><span>Platform fee</span><span>@Model.PlatformFee.ToString("0.00") EGP</span></div>
                        @if (Model.PromotionDiscount > 0)
                        {
                            <div class="d-flex justify-content-between mb-1 text-success"><span>Promo discount (@Model.Promotion?.Code)</span><span>-@Model.PromotionDiscount.ToString("0.00") EGP</span></div>
                        }
                        <hr />
                        <div class="d-flex justify-content-between mb-1"><strong>Total due</strong><strong class="text-primary">@Model.FinalAmountDue.ToString("0.00") EGP</strong></div>
                        <div class="d-flex justify-content-between text-muted small"><span>Refundable deposit (held)</span><span>@Model.DepositAmount.ToString("0.00") EGP</span></div>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header bg-white"><h2 class="h6 mb-0">Promo code</h2></div>
                    <div class="card-body">
                        @if (Model.PromotionId.HasValue)
                        {
                            <div class="d-flex justify-content-between align-items-center">
                                <span><span class="badge text-bg-success">@Model.Promotion?.Code</span> applied — saved @Model.PromotionDiscount.ToString("0.00") EGP</span>
                                <form asp-action="RemovePromo" asp-route-id="@Model.BookingId" method="post">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger">Remove</button></form>
                            </div>
                        }
                        else
                        {
                            <form asp-action="ApplyPromo" asp-route-id="@Model.BookingId" method="post" class="d-flex gap-2">
                                @Html.AntiForgeryToken()
                                <input type="text" name="code" class="form-control text-uppercase" placeholder="Enter promo code" required />
                                <button class="btn btn-outline-primary text-nowrap">Apply</button>
                            </form>
                            @if (promos.Count > 0)
                            {
                                <div class="mt-2">
                                    <div class="text-muted small mb-1">Available promos:</div>
                                    @foreach (var p in promos)
                                    {
                                        <span class="badge text-bg-light border me-1 mb-1">@p.Code — @(p.DiscountType == DiscountTypeEnum.Percentage ? $"{p.DiscountPercentage}%" : $"{p.DiscountAmount:0} EGP") off</span>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card shadow-sm">
                    <div class="card-header bg-white"><h2 class="h6 mb-0">Payment</h2></div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3">
                            <span>Wallet balance</span>
                            <strong class="@(wallet >= (Model.FinalAmountDue + Model.DepositAmount) ? "text-success" : "text-danger")">@wallet.ToString("0.00") EGP</strong>
                        </div>
                        @if (wallet < Model.FinalAmountDue)
                        {
                            <div class="alert alert-warning small">Insufficient balance — top up via the wallet page or contact support.</div>
                        }
                        <form asp-action="Pay" asp-route-id="@Model.BookingId" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success w-100" disabled="@(wallet < Model.FinalAmountDue)">
                                <i class="fas fa-lock"></i> Pay @((Model.FinalAmountDue + Model.DepositAmount).ToString("0.00")) EGP
                            </button>
                        </form>
                        <p class="text-muted small mt-3 mb-0">Payment is held in escrow until the tool is returned and verified.</p>
                    </div>
                </div>
                <a asp-controller="Member" asp-action="Details" asp-route-id="@Model.BookingId" class="btn btn-link px-0 mt-2">← Back to booking</a>
            </div>
        </div>
    </div>
</div>
