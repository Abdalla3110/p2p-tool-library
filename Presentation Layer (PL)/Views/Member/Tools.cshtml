@model List<DAL.Models.Entities.Tool>
@{ ViewData["Title"] = "My Tools"; }

@functions {
    string Badge(string s) => s switch
    {
        "Available" => "text-bg-success",
        "Rented" => "text-bg-info",
        "Maintenance" or "PendingApproval" => "text-bg-warning text-dark",
        "Locked" or "Unfit" => "text-bg-danger",
        _ => "text-bg-secondary",
    };
}

<div class="py-5">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h1 class="h3 fw-bold mb-1"><i class="fas fa-toolbox text-primary me-2"></i>My Tools</h1>
                <p class="text-muted mb-0">Tools you own and list for rent.</p>
            </div>
            <a asp-action="ToolCreate" class="btn btn-primary"><i class="fas fa-plus"></i> Add New Tool</a>
        </div>

        @if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }

        @if (Model.Count == 0)
        {
            <div class="alert alert-info">You haven't listed any tools yet. <a asp-action="ToolCreate">Add your first tool</a>.</div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead><tr><th>Tool</th><th>Category</th><th>Zone</th><th>Price/day</th><th>Deposit</th><th>Rentals</th><th>Status</th><th>Actions</th></tr></thead>
                        <tbody>
                            @foreach (var t in Model)
                            {
                                <tr>
                                    <td><strong>@t.Name</strong>@if (t.Brand != null) { <div class="text-muted small">@t.Brand</div> }</td>
                                    <td>@t.Category?.Name</td>
                                    <td>@t.Zone?.Name</td>
                                    <td>@t.PricePerDay.ToString("0") EGP</td>
                                    <td>@t.DepositAmount.ToString("0") EGP</td>
                                    <td>@t.TotalRentals</td>
                                    <td><span class="badge @Badge(t.Status.ToString())">@t.Status.ToString().Replace("PendingApproval", "Pending Approval")</span></td>
                                    <td>
                                        <a asp-controller="Home" asp-action="Details" asp-route-id="@t.ToolId" class="btn btn-sm btn-outline-primary">View</a>
                                        <a asp-action="ToolEdit" asp-route-id="@t.ToolId" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
