@model List<DAL.Models.Entities.LibrarianTask>
@{ ViewData["Title"] = "My Tasks"; }

<div class="py-5">
    <div class="container">
        <h1 class="h3 fw-bold mb-4"><i class="fas fa-list-check text-primary me-2"></i>My Tasks</h1>
        @if (Model.Count == 0)
        {
            <div class="alert alert-info">No tasks assigned.</div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>Task</th><th>Type</th><th>Related</th><th>Due</th><th>Priority</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var t in Model)
                            {
                                <tr class="@(t.Status == "Completed" ? "text-muted" : "")">
                                    <td><strong>@t.Title</strong><div class="text-muted small">@t.Description</div></td>
                                    <td>@t.Type</td>
                                    <td>@(t.RelatedEntityType != null ? $"{t.RelatedEntityType} #{t.RelatedEntityId}" : "—")</td>
                                    <td>@t.DueAt?.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td><span class="badge text-bg-light border">@t.Priority</span></td>
                                    <td><span class="badge @(t.Status == "Completed" ? "text-bg-success" : "text-bg-warning text-dark")">@t.Status</span></td>
                                    <td>
                                        @if (t.Status != "Completed")
                                        {
                                            <form asp-action="CompleteTask" asp-route-id="@t.TaskId" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-success">Complete</button></form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
