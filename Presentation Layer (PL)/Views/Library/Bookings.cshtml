@{ ViewData["Title"] = "All Bookings"; var bookings = (List<DAL.Models.Entities.Booking>)ViewBag.Bookings; var statuses = (string[])ViewBag.Statuses; }

<div class="py-5">
    <div class="container">
        <h1 class="h3 fw-bold mb-4"><i class="fas fa-calendar-alt text-primary me-2"></i>All Bookings</h1>

        <form method="get" class="d-flex gap-2 mb-3" style="max-width:320px;">
            <select name="status" class="form-select">
                <option value="All" selected="@(ViewBag.Status == "All" || ViewBag.Status == null)">All statuses</option>
                @foreach (var s in statuses) { <option value="@s" selected="@(ViewBag.Status == s)">@s</option> }
            </select>
            <button class="btn btn-outline-primary">Filter</button>
        </form>

        @if (bookings.Count == 0)
        {
            <div class="alert alert-info">No bookings found.</div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead><tr><th>#</th><th>Tool</th><th>Borrower</th><th>Lender</th><th>Dates</th><th>Total</th><th>Deposit</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var b in bookings)
                            {
                                <tr>
                                    <td>@b.BookingId</td>
                                    <td>@b.Tool?.Name</td>
                                    <td>@b.BorrowerUser?.FullName</td>
                                    <td>@b.LenderUser?.FullName</td>
                                    <td>@b.PickupDate.ToString("yyyy-MM-dd") → @b.ReturnDate.ToString("yyyy-MM-dd")</td>
                                    <td>@b.TotalAmount.ToString("0") EGP</td>
                                    <td>@b.DepositAmount.ToString("0") EGP (@b.DepositStatus)</td>
                                    <td><span class="badge @(b.Status == BookingStatusEnum.Completed ? "text-bg-success" : b.Status == BookingStatusEnum.Cancelled ? "text-bg-danger" : (b.Status == BookingStatusEnum.Active || b.Status == BookingStatusEnum.Confirmed) ? "text-bg-primary" : "text-bg-warning text-dark")">@b.Status</span></td>
                                    <td>
    @if (b.Status == BookingStatusEnum.WaitingHandover)
    {
        <form asp-action="ConfirmBooking" asp-route-id="@b.BookingId" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button class="btn btn-sm btn-success me-1">Approve</button>
        </form>
    }
    <a asp-controller="Member" asp-action="Details" asp-route-id="@b.BookingId" class="btn btn-sm btn-outline-primary">Open</a>
</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
