@{ ViewData["Title"] = "Library Dashboard"; }

<div class="py-5">
    <div class="container">
        <h1 class="h3 fw-bold mb-1"><i class="fas fa-book-open text-primary me-2"></i>Library Dashboard</h1>
        <p class="text-muted mb-4">Librarian operations overview — disputes, audits, handovers, and approvals.</p>

        <div class="row g-3 mb-4">
            <div class="col-md-2"><a asp-action="Disputes" class="text-decoration-none"><div class="card shadow-sm"><div class="card-body text-center"><div class="display-6 fw-bold text-danger">@ViewBag.OpenDisputes</div><div class="text-muted small">Open Disputes</div></div></div></a></div>
            <div class="col-md-2"><a asp-action="Audits" class="text-decoration-none"><div class="card shadow-sm"><div class="card-body text-center"><div class="display-6 fw-bold text-warning">@ViewBag.PendingAudits</div><div class="text-muted small">Pending Audits</div></div></div></a></div>
            <div class="col-md-2"><a asp-action="Tools" class="text-decoration-none"><div class="card shadow-sm"><div class="card-body text-center"><div class="display-6 fw-bold text-primary">@ViewBag.PendingTools</div><div class="text-muted small">Tool Approvals</div></div></div></a></div>
            <div class="col-md-2"><a asp-action="Users" class="text-decoration-none"><div class="card shadow-sm"><div class="card-body text-center"><div class="display-6 fw-bold text-info">@ViewBag.PendingKyc</div><div class="text-muted small">KYC Pending</div></div></div></a></div>
            <div class="col-md-2"><a asp-action="Handovers" class="text-decoration-none"><div class="card shadow-sm"><div class="card-body text-center"><div class="display-6 fw-bold text-success">@ViewBag.TodayHandovers</div><div class="text-muted small">Handovers Today</div></div></div></a></div>
            <div class="col-md-2"><a asp-action="LateReturns" class="text-decoration-none"><div class="card shadow-sm"><div class="card-body text-center"><div class="display-6 fw-bold text-danger">@ViewBag.OpenLateReturns</div><div class="text-muted small">Late Returns</div></div></div></a></div>
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white d-flex justify-content-between">
                        <h2 class="h6 mb-0">My Tasks</h2>
                        <a asp-action="Tasks" class="btn btn-sm btn-outline-primary">All tasks</a>
                    </div>
                    <ul class="list-group list-group-flush">
                        @foreach (var t in (List<DAL.Models.Entities.LibrarianTask>)ViewBag.MyTasks)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div><strong>@t.Title</strong><div class="text-muted small">@t.Type • due @t.DueAt?.ToString("yyyy-MM-dd HH:mm")</div></div>
                                <form asp-action="CompleteTask" asp-route-id="@t.TaskId" method="post">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-success">Done</button></form>
                            </li>
                        }
                        @if (((List<DAL.Models.Entities.LibrarianTask>)ViewBag.MyTasks).Count == 0)
                        {
                            <li class="list-group-item text-muted">No open tasks.</li>
                        }
                    </ul>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header bg-white d-flex justify-content-between">
                        <h2 class="h6 mb-0">Recent Disputes</h2>
                        <a asp-action="Disputes" class="btn btn-sm btn-outline-primary">All disputes</a>
                    </div>
                    <ul class="list-group list-group-flush">
                        @foreach (var d in (List<DAL.Models.Entities.Dispute>)ViewBag.RecentDisputes)
                        {
                            <li class="list-group-item">
                                <div class="d-flex justify-content-between">
                                    <strong>#@d.DisputeId — @d.Type</strong>
                                    <span class="badge text-bg-warning text-dark">@d.Status</span>
                                </div>
                                <div class="text-muted small">@d.Tool?.Name • reported by @d.ReportedByUser?.FullName</div>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card shadow-sm">
                    <div class="card-header bg-white"><h2 class="h6 mb-0">Quick actions</h2></div>
                    <div class="list-group list-group-flush">
                        <a asp-action="Tools" class="list-group-item list-group-item-action"><i class="fas fa-check-circle text-success me-2"></i>Approve pending tools</a>
                        <a asp-action="Users" class="list-group-item list-group-item-action"><i class="fas fa-id-card text-info me-2"></i>Review KYC submissions</a>
                        <a asp-action="Handovers" class="list-group-item list-group-item-action"><i class="fas fa-qrcode text-primary me-2"></i>Verify QR handovers</a>
                        <a asp-action="Broadcasts" class="list-group-item list-group-item-action"><i class="fas fa-bullhorn text-warning me-2"></i>Send broadcast</a>
                        <a asp-action="Blacklist" class="list-group-item list-group-item-action"><i class="fas fa-ban text-danger me-2"></i>Blacklist management</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
