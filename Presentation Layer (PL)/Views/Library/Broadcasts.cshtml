@{ ViewData["Title"] = "Broadcasts"; var broadcasts = (List<DAL.Models.Entities.Broadcast>)ViewBag.Broadcasts; var zones = (List<DAL.Models.Entities.Zone>)ViewBag.Zones; }

<div class="py-5">
    <div class="container">
        <h1 class="h3 fw-bold mb-4"><i class="fas fa-bullhorn text-primary me-2"></i>Broadcasts</h1>

        @if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white"><h2 class="h6 mb-0">Send broadcast</h2></div>
            <div class="card-body">
                <form asp-action="SendBroadcast" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-3">
                        <label class="form-label">Zone (empty = all)</label>
                        <select name="zoneId" class="form-select">
                            <option value="">All zones</option>
                            @foreach (var z in zones) { <option value="@z.ZoneId">@z.Name</option> }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Priority</label>
                        <select name="priority" class="form-select">
                            <option>Normal</option><option>High</option><option>Emergency</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Title</label>
                        <input type="text" name="title" class="form-control" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Message</label>
                        <textarea name="message" class="form-control" rows="3" required></textarea>
                    </div>
                    <div class="col-12"><button class="btn btn-primary"><i class="fas fa-paper-plane"></i> Send</button></div>
                </form>
            </div>
        </div>

        @if (broadcasts.Count == 0)
        {
            <div class="alert alert-info">No broadcasts sent yet.</div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>Title</th><th>Zone</th><th>Priority</th><th>Recipients</th><th>Sent by</th><th>Sent at</th></tr></thead>
                        <tbody>
                            @foreach (var b in broadcasts)
                            {
                                <tr>
                                    <td><strong>@b.Title</strong><div class="text-muted small">@b.Message</div></td>
                                    <td>@(b.Zone?.Name ?? "All zones")</td>
                                    <td><span class="badge @(b.Priority == "Emergency" ? "text-bg-danger" : b.Priority == "High" ? "text-bg-warning text-dark" : "text-bg-light border")">@b.Priority</span></td>
                                    <td>@b.RecipientCount</td>
                                    <td>@b.SentByUser?.FullName</td>
                                    <td>@b.SentAt.ToString("yyyy-MM-dd HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
