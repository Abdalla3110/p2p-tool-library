@{ ViewData["Title"] = "Blacklist"; var suspensions = (List<DAL.Models.Entities.UserSuspension>)ViewBag.Suspensions; var users = (System.Collections.Generic.IEnumerable<dynamic>)ViewBag.Users; }

<div class="py-5">
    <div class="container">
        <h1 class="h3 fw-bold mb-4"><i class="fas fa-ban text-primary me-2"></i>Blacklist &amp; Suspensions</h1>

        @if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
        @if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white"><h2 class="h6 mb-0">Suspend a user</h2></div>
            <div class="card-body">
                <form asp-action="SuspendUser" method="post" class="row g-3 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-md-3">
                        <label class="form-label">User</label>
                        <select name="userId" class="form-select" required>
                            <option value="">Choose…</option>
                            @foreach (var u in users) { <option value="@u.UserId">@u.FullName</option> }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Reason</label>
                        <select name="reason" class="form-select" required>
                            <option>LateReturns</option><option>Damage</option><option>Fraud</option><option>PolicyViolation</option><option>Other</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Days (empty = permanent)</label>
                        <input type="number" name="days" min="1" class="form-control" placeholder="e.g. 30" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Description</label>
                        <input type="text" name="description" class="form-control" />
                    </div>
                    <div class="col-md-2"><button class="btn btn-danger w-100"><i class="fas fa-ban"></i> Suspend</button></div>
                </form>
            </div>
        </div>

        @if (suspensions.Count == 0)
        {
            <div class="alert alert-info">No suspensions on record.</div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>User</th><th>Type</th><th>Reason</th><th>Period</th><th>Status</th><th>Created by</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var s in suspensions)
                            {
                                <tr>
                                    <td><strong>@s.User?.FullName</strong></td>
                                    <td>@s.Type</td>
                                    <td>@s.Reason</td>
                                    <td>@s.StartDate.ToString("yyyy-MM-dd") → @(s.EndDate?.ToString("yyyy-MM-dd") ?? "∞")</td>
                                    <td><span class="badge @(s.Status == SuspensionStatusEnum.Active ? "text-bg-danger" : "text-bg-success")">@s.Status</span></td>
                                    <td>@s.CreatedByUser?.FullName</td>
                                    <td>
                                        @if (s.Status == SuspensionStatusEnum.Active)
                                        {
                                            <form asp-action="LiftSuspension" asp-route-id="@s.SuspensionId" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-success">Lift</button></form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
