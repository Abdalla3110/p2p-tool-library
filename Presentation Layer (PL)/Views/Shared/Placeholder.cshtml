@{ ViewData["Title"] = "Dashboard"; }
<div class="py-5">
    <div class="container">
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="fas fa-tools fa-3x text-primary mb-3"></i>
                <h1 class="h3">@ViewData["RoleName"] Dashboard</h1>
                <p class="text-muted">This area is being built — the prototype screens are being converted to MVC.</p>
                <a asp-controller="Home" asp-action="Tools" class="btn btn-outline-primary">Browse Tools</a>
            </div>
        </div>
    </div>
</div>
