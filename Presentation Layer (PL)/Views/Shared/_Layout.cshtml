@using System.Security.Claims
@{
    var isAuth = User.Identity?.IsAuthenticated == true;
    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "Member";
    var userName = User.FindFirst(ClaimTypes.Name)?.Value ?? "Account";
    var initials = string.Concat(userName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpper(w[0])));
    var dashboardUrl = role switch
    {
        "Admin" => Url.Action("Index", "Admin"),
        "Librarian" => Url.Action("Index", "Library"),
        "Technician" => Url.Action("Index", "Maintenance"),
        _ => Url.Action("Index", "Member"),
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] — ToolShare</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/bootstrap-overrides.css?v=1" asp-append-version="true">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/dashboard.css?v=2" asp-append-version="true">
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div id="app">
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
            <div class="container-fluid">
                <a class="navbar-brand logo" asp-controller="Home" asp-action="Index"><i class="fas fa-tools"></i><span>ToolShare</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Tools"><i class="fas fa-search"></i> Browse Tools</a></li>
                        @if (isAuth)
                        {
                            <li class="nav-item"><a class="nav-link" href="@dashboardUrl"><i class="fas fa-gauge-high"></i> Dashboard</a></li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                    <span class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center" style="width:28px;height:28px;font-size:.75rem;">@initials</span>
                                    <span class="ms-1">@userName</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><span class="dropdown-item-text small text-muted">@role</span></li>
                                    @if (role == "Member")
                                    {
                                        <li><a class="dropdown-item" asp-controller="Member" asp-action="Tools"><i class="fas fa-toolbox"></i> My Tools</a></li>
                                        <li><a class="dropdown-item" asp-controller="Member" asp-action="Bookings"><i class="fas fa-calendar-check"></i> My Bookings</a></li>
                                        <li><a class="dropdown-item" asp-controller="Member" asp-action="Wallet"><i class="fas fa-wallet"></i> Wallet</a></li>
                                        <li><a class="dropdown-item" asp-controller="Member" asp-action="Notifications"><i class="fas fa-bell"></i> Notifications <span id="notifBadge" class="badge text-bg-danger rounded-pill ms-1 d-none" style="font-size:.65rem;">0</span></a></li>
<li><a class="dropdown-item" asp-controller="Disputes" asp-action="Index"><i class="fas fa-gavel"></i> My Disputes</a></li>
<li><a class="dropdown-item" asp-controller="Claims" asp-action="Index"><i class="fas fa-file-invoice"></i> My Claims</a></li>
<li><a class="dropdown-item" asp-controller="Member" asp-action="Messages"><i class="fas fa-comments"></i> Messages</a></li>
<li><a class="dropdown-item" asp-controller="Member" asp-action="Profile"><i class="fas fa-user"></i> Profile</a></li>
<li><a class="dropdown-item" asp-controller="Member" asp-action="Ratings"><i class="fas fa-star"></i> Ratings</a></li>
<li><a class="dropdown-item" asp-controller="Member" asp-action="Referral"><i class="fas fa-user-friends"></i> Referrals</a></li>
                                    }
                                    @if (role == "Technician")
                                    {
                                        <li><a class="dropdown-item" asp-controller="Maintenance" asp-action="Tools"><i class="fas fa-heart-pulse"></i> Tool Health</a></li>
                                        <li><a class="dropdown-item" asp-controller="Maintenance" asp-action="Records"><i class="fas fa-clipboard-list"></i> Records</a></li>
                                        <li><a class="dropdown-item" asp-controller="Maintenance" asp-action="Repairs"><i class="fas fa-truck"></i> External Repairs</a></li>
                                        <li><a class="dropdown-item" asp-controller="Maintenance" asp-action="Disposals"><i class="fas fa-trash"></i> Disposals</a></li>
                                        <li><a class="dropdown-item" asp-controller="Maintenance" asp-action="Profile"><i class="fas fa-id-badge"></i> My Profile</a></li>
                                    }
                                    @if (role is "Librarian" or "Admin")
                                    {
                                        <li><a class="dropdown-item" asp-controller="Library" asp-action="Tasks"><i class="fas fa-list-check"></i> My Tasks</a></li>
                                        <li><a class="dropdown-item" asp-controller="Library" asp-action="Disputes"><i class="fas fa-gavel"></i> Disputes</a></li>
                                        <li><a class="dropdown-item" asp-controller="Library" asp-action="Audits"><i class="fas fa-clipboard-check"></i> Audits</a></li>
                                        <li><a class="dropdown-item" asp-controller="Library" asp-action="Handovers"><i class="fas fa-qrcode"></i> Handovers</a></li>
                                        <li><a class="dropdown-item" asp-controller="Library" asp-action="Claims"><i class="fas fa-file-invoice"></i> Claims</a></li>
                                        <li><a class="dropdown-item" asp-controller="Library" asp-action="Tools"><i class="fas fa-check-circle"></i> Tool Approvals</a></li>
                                        <li><a class="dropdown-item" asp-controller="Library" asp-action="Users"><i class="fas fa-users"></i> Users &amp; KYC</a></li>
                                        <li><a class="dropdown-item" asp-controller="Library" asp-action="Broadcasts"><i class="fas fa-bullhorn"></i> Broadcasts</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Home" asp-action="Logout" method="post" class="px-3">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm w-100"><i class="fas fa-sign-out-alt"></i> Logout</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="btn btn-outline-primary" asp-controller="Home" asp-action="Login">Login</a></li>
                            <li class="nav-item"><a class="btn btn-primary" asp-controller="Home" asp-action="Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>

        <main>
            @RenderBody()
        </main>

        <footer class="footer py-4 mt-5">
            <div class="container text-center text-muted">
                <p class="mb-1">&copy; @DateTime.Now.Year ToolShare. All rights reserved.</p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Privacy Policy</a>
                    <a asp-controller="Home" asp-action="Terms" class="text-decoration-none">Terms of Service</a>
                    <a asp-controller="Home" asp-action="Support" class="text-decoration-none">Safety Guidelines</a>
                </div>
            </div>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/ui.js" asp-append-version="true"></script>
@if (User.Identity?.IsAuthenticated == true)
{
    <script>
        (function () {
            var badge = document.getElementById('notifBadge');
            if (!badge) return;
            function poll() {
                fetch('/Member/UnreadCount').then(function (r) { return r.json(); }).then(function (d) {
                    badge.textContent = d.count;
                    badge.classList.toggle('d-none', d.count === 0);
                }).catch(function () {});
            }
            poll();
            setInterval(poll, 30000);
        })();
    </script>
}
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
