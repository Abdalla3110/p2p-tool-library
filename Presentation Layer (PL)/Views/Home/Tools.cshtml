@model DAL.Models.ViewModels.BrowseToolsViewModel
@{ ViewData["Title"] = "Browse Tools"; }

@functions {
    string StatusBadge(string status, bool highValue)
    {
        if (highValue) return "<span class=\"badge text-bg-warning text-dark\">High Value</span>";
        return status switch
        {
            "Available" => "<span class=\"badge text-bg-success\">Available</span>",
            "Rented" => "<span class=\"badge text-bg-info\">Rented</span>",
            "Maintenance" => "<span class=\"badge text-bg-warning text-dark\">Maintenance</span>",
            "Locked" or "Unfit" => "<span class=\"badge text-bg-danger\">" + status + "</span>",
            _ => "<span class=\"badge text-bg-secondary\">" + status + "</span>",
        };
    }
    string Stars(decimal rating)
    {
        var full = (int)Math.Round(rating);
        return string.Concat(Enumerable.Repeat("★", Math.Clamp(full, 0, 5))) +
               string.Concat(Enumerable.Repeat("☆", 5 - Math.Clamp(full, 0, 5)));
    }
}

<div class="py-5">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
            <div>
                <h1 class="h2 fw-bold mb-1"><i class="fas fa-tools text-primary me-2"></i>Browse Tools</h1>
                <p class="text-muted mb-0">Find the right tool near you, compare pricing, and book with confidence.</p>
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Member" asp-action="Index" class="btn btn-outline-primary"><i class="fas fa-gauge-high"></i> My Dashboard</a>
            }
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <form method="get" asp-action="Index">
                    <div class="row g-3">
                        <div class="col-lg-4">
                            <label class="form-label">Search</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-search"></i></span>
                                <input type="text" name="Search" value="@Model.Search" class="form-control" placeholder="Example: cordless drill, saw, printer…">
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-4">
                            <label class="form-label">Category</label>
                            <select name="CategoryId" class="form-select">
                                <option value="">All Categories</option>
                                @foreach (var c in Model.Categories)
                                {
                                    <option value="@c.CategoryId" selected="@(Model.CategoryId == c.CategoryId)">@c.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-4">
                            <label class="form-label">Zone</label>
                            <select name="ZoneId" class="form-select">
                                <option value="">All Zones</option>
                                @foreach (var z in Model.Zones)
                                {
                                    <option value="@z.ZoneId" selected="@(Model.ZoneId == z.ZoneId)">@z.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-4">
                            <label class="form-label">Sort By</label>
                            <select name="Sort" class="form-select">
                                <option value="rating" selected="@(Model.Sort == "rating")">Top Rated</option>
                                <option value="nearest" selected="@(Model.Sort == "nearest")">Nearest First</option>
                                <option value="priceAsc" selected="@(Model.Sort == "priceAsc")">Price: Low to High</option>
                                <option value="priceDesc" selected="@(Model.Sort == "priceDesc")">Price: High to Low</option>
                                <option value="newest" selected="@(Model.Sort == "newest")">Newest</option>
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-4 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100"><i class="fas fa-filter"></i> Apply</button>
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-md-2">
                            <label class="form-label">Min Price</label>
                            <input type="number" name="MinPrice" value="@Model.MinPrice" class="form-control" placeholder="0">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Max Price</label>
                            <input type="number" name="MaxPrice" value="@Model.MaxPrice" class="form-control" placeholder="500">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Available From</label>
                            <input type="date" name="AvailableFrom" value="@Model.AvailableFrom?.ToString("yyyy-MM-dd")" class="form-control">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Available To</label>
                            <input type="date" name="AvailableTo" value="@Model.AvailableTo?.ToString("yyyy-MM-dd")" class="form-control">
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <a asp-action="Index" class="btn btn-outline-secondary w-100"><i class="fas fa-rotate-left"></i> Reset</a>
                        </div>
                    </div>
                </form>
                <div class="mt-3">
                    <span class="badge text-bg-light border">@Model.TotalCount tools found</span>
                    @if (Model.TotalPages > 1)
                    {
                        <span class="text-muted small ms-2">page @Model.Page of @Model.TotalPages</span>
                    }
                </div>
            </div>
        </div>

        @if (Model.Tools.Count == 0)
        {
            <div class="alert alert-info"><i class="fas fa-info-circle me-2"></i>No tools match your filters. Try widening your search.</div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var tool in Model.Tools)
                {
                    <div class="col-xl-3 col-lg-4 col-md-6">
                        <div class="card h-100 tool-card shadow-sm">
                            <div class="bg-light text-center py-4 rounded-top">
                                <i class="@tool.CategoryIcon fa-3x text-primary"></i>
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <h3 class="h5 mb-0">@tool.Name</h3>
                                    @Html.Raw(StatusBadge(tool.Status, tool.IsHighValue))
                                </div>
                                <div class="text-muted small mb-2"><i class="fas fa-map-marker-alt text-primary me-1"></i> @tool.ZoneName • by @tool.OwnerName</div>
                                <div class="mb-2"><span class="text-warning">@Html.Raw(Stars(tool.RatingAverage))</span> <span class="text-muted small">(@tool.RatingAverage.ToString("0.0") · @tool.ReviewCount reviews)</span></div>
                                <div class="fw-bold text-primary fs-5">@tool.PricePerDay.ToString("0") EGP/day</div>
                                <div class="text-muted small">Deposit: @tool.DepositAmount.ToString("0") EGP</div>
                            </div>
                            <div class="card-footer bg-white">
                                <a asp-controller="Home" asp-action="Details" asp-route-id="@tool.ToolId" class="btn btn-primary w-100"><i class="fas fa-calendar-check"></i> View &amp; Book</a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination justify-content-center">
                        @for (var p = 1; p <= Model.TotalPages; p++)
                        {
                            var url = Url.Action("Index", new
                            {
                                search = Model.Search, categoryId = Model.CategoryId, zoneId = Model.ZoneId,
                                minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sort = Model.Sort,
                                availableFrom = Model.AvailableFrom, availableTo = Model.AvailableTo, page = p,
                            });
                            <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="@url">@p</a></li>
                        }
                    </ul>
                </nav>
            }
        }
    </div>
</div>
