@{ ViewData["Title"] = "Safety Guidelines & Support"; }
<div class="py-5">
    <div class="container" style="max-width: 800px;">
        <h1 class="h3 mb-4">Safety Guidelines &amp; Support</h1>
        <div class="alert alert-info"><i class="fas fa-shield-alt me-2"></i>Every rental is covered by our librarian-supervised safety program.</div>
        <h5>Before you borrow</h5>
        <ul>
            <li>Check the tool's condition, safety certificate, and user manual.</li>
            <li>Watch the safety video for power tools.</li>
            <li>Confirm the pickup handover checklist with the owner or librarian.</li>
        </ul>
        <h5>During the rental</h5>
        <ul>
            <li>Use the tool only for its intended purpose.</li>
            <li>Return it on time — late returns may incur fines.</li>
            <li>Report any damage immediately via the damage report flow.</li>
        </ul>
        <h5>Need help?</h5>
        <p>Our support team mediates disputes, processes insurance claims, and answers questions about bookings and payments. Contact us through the messages page or visit your local chapter (zone) librarian.</p>
    </div>
</div>
