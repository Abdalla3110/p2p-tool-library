@model DAL.Models.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Login"; Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login — ToolShare</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body { background: linear-gradient(135deg, #0d6efd22, #6610f322); min-height: 100vh; display: flex; align-items: center; }
        .auth-card { max-width: 440px; margin: auto; }
    </style>
</head>
<body>
    <div class="container">
        <div class="card shadow auth-card">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <a href="/" class="text-decoration-none"><i class="fas fa-tools fa-2x text-primary"></i><span class="h4 fw-bold text-dark ms-2">ToolShare</span></a>
                    <h5 class="mt-3 text-muted">Welcome back</h5>
                </div>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                @if (TempData["Success"] is string ok)
                {
                    <div class="alert alert-success py-2">@ok</div>
                }
                @if (TempData["DevResetLink"] is string rl)
                {
                    <div class="alert alert-warning py-2 small"><strong>DEV MODE</strong> — no SMTP configured. Reset link: <a href="@rl">@rl</a></div>
                }
                @if (TempData["DevVerifyLink"] is string vl)
                {
                    <div class="alert alert-warning py-2 small"><strong>DEV MODE</strong> — verify email: <a href="@vl">@vl</a></div>
                }
                <form method="post" asp-action="Login">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" type="email" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" class="form-control" type="password" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                            <label asp-for="RememberMe" class="form-check-label">Remember me</label>
                        </div>
                        <a asp-action="ForgotPassword" class="text-decoration-none small">Forgot password?</a>
                    </div>
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-sign-in-alt"></i> Login</button>
                </form>
                <hr>
                <div class="text-center">
                    <span class="text-muted small">Don't have an account?</span>
                    <a href="/Home/Register" class="small">Create one</a>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
