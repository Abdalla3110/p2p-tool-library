@{ ViewData["Title"] = "Forgot Password"; }

<div class="container py-5" style="max-width: 480px;">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h1 class="h4 fw-bold mb-1">Forgot password</h1>
            <p class="text-muted small">Enter your email and we'll send a reset link.</p>

            <form method="post" asp-action="ForgotPassword">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" name="email" class="form-control" required />
                </div>
                <button type="submit" class="btn btn-primary w-100">Send reset link</button>
            </form>
            <a asp-action="Login" class="d-block text-center mt-3 text-decoration-none small">← Back to login</a>
        </div>
    </div>
</div>
