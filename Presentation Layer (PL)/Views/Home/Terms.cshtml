@{ ViewData["Title"] = "Terms of Service"; }
<div class="py-5">
    <div class="container" style="max-width: 800px;">
        <h1 class="h3 mb-4">Terms of Service</h1>
        <p class="text-muted">Last updated: 2024</p>
        <h5>1. The Service</h5>
        <p>ToolShare is a peer-to-peer marketplace that connects tool owners ("Lenders") with people who want to borrow tools ("Borrowers"). The platform is supervised by our librarian team.</p>
        <h5>2. Accounts</h5>
        <p>You must provide accurate information and complete identity verification (KYC) before listing tools or making bookings. You are responsible for activity under your account.</p>
        <h5>3. Rentals</h5>
        <p>Bookings are confirmed once payment and deposit are secured. The deposit is held in escrow and released after the tool is returned in acceptable condition.</p>
        <h5>4. Prohibited Use</h5>
        <p>Do not list illegal, dangerous, or recalled items. Tools must match their listing description and be safe to operate.</p>
        <h5>5. Liability</h5>
        <p>ToolShare facilitates rentals between users. We mediate disputes but are not a party to the rental agreement between members.</p>
        <h5>6. Termination</h5>
        <p>We may suspend or terminate accounts that violate these terms, damage tools, or commit fraud.</p>
    </div>
</div>
